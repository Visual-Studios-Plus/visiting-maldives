{
  "name": "visting-maldives",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "vercel-build": "prisma generate && node scripts/migrate-if-db.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "db:migrate": "node --env-file-if-exists=.env.local node_modules/prisma/build/index.js migrate dev",
    "db:deploy": "node --env-file-if-exists=.env.local node_modules/prisma/build/index.js migrate deploy",
    "db:studio": "node --env-file-if-exists=.env.local node_modules/prisma/build/index.js studio",
    "db:status": "node --env-file-if-exists=.env.local node_modules/prisma/build/index.js migrate status",
    "db:seed": "node --env-file-if-exists=.env.local --no-warnings prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1164.0",
    "@aws-sdk/s3-presigned-post": "^3.1164.0",
    "@aws-sdk/s3-request-presigner": "^3.1164.0",
    "@gsap/react": "^2.1.2",
    "@neon/config": "^1.13.0",
    "@neon/env": "^2.1.0",
    "@prisma/client": "^6.19.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.2",
    "files-sdk": "^3.1.2",
    "gsap": "^3.15.1",
    "lenis": "^1.3.27",
    "lucide-react": "^1.70.0",
    "next": "16.4.5",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "prisma": {
    "seed": "node --no-warnings prisma/seed.ts"
  }
}
