// Database for the dashboard: staff accounts, content, metrics and sign-in limits.
// Change a model here, run `npm run db:migrate -- --name what-changed` against a dev database,
// commit the new folder in prisma/migrations, and Vercel applies it on the next deploy.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Neon on Vercel sets both: the pooled URL for the site, the direct one for migrations
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

/// ADMIN: everything (accounts, deleting, reordering, restoring). WRITER: create and edit content.
enum Role {
  ADMIN
  WRITER
}

/// A dashboard account. Passwords are scrypt hashes, never stored in readable form.
model User {
  id             String    @id @default(cuid())
  email          String    @unique
  name           String
  role           Role      @default(WRITER)
  passwordHash   String    @map("password_hash")
  active         Boolean   @default(true)
  /// Bumped to sign the user out everywhere (role change, deactivation, password reset)
  sessionVersion Int       @default(1) @map("session_version")
  lastLoginAt    DateTime? @map("last_login_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@map("users")
}

/// One row per editable collection (guides, atolls, stays, eats, events, essentials),
/// holding the whole list as JSON in the order shown on the site.
model SiteContent {
  key       String   @id
  data      Json
  updatedAt DateTime @updatedAt @map("updated_at")
  /// Who saved it last (user id), for the dashboard
  updatedBy String?  @map("updated_by")

  @@map("site_content")
}

/// Daily counters, e.g. (guide, manta-season, view, 2026-11-10) = 42. No personal data.
model Metric {
  type  String /// guide | stay | atoll
  slug  String
  event String /// view | save | unsave
  day   DateTime @db.Date
  count Int      @default(0)

  @@id([type, slug, event, day])
  @@index([type, day])
  @@index([day])
  @@map("metrics")
}

/// Failed dashboard sign-ins, keyed by a salted hash of the address (never the address itself).
model AdminLoginAttempt {
  id  Int      @id @default(autoincrement())
  key String
  at  DateTime @default(now())

  @@index([key, at])
  @@index([at])
  @@map("admin_login_attempts")
}

/// A place to stay (resort, hotel, guesthouse, homestay, liveaboard, yacht marina): one row each,
/// published at /stay/<slug> and edited in the dashboard. Its facts, photos and reviews are rows
/// of their own below, so nothing is kept as a blob of JSON.
model Stay {
  id        String   @id @default(cuid())
  slug      String   @unique
  /// order on the site and in the dashboard
  position  Int
  name      String
  /// Resort | Resort island | Hotel | Guesthouse | Homestay | Liveaboard | Marina
  type      String
  atoll     String   @default("")
  atollSlug String?  @map("atoll_slug")
  island    String?
  lat       Float?
  lng       Float?
  price     String   @default("")
  note      String   @default("")
  about     String   @default("")
  image     String   @default("")
  partner   Boolean  @default(false)
  rating    Float?
  rooms     Int?
  beds      Int?
  berths    Int?
  phone     String?
  email     String?
  website   String?
  licensed  Boolean  @default(false)
  amenities String[] @default([])
  /// dashboard user who created it
  author    String?
  updatedBy String?  @map("updated_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  facts   StayFact[]
  photos  StayPhoto[]
  reviews StayReview[]

  @@index([atollSlug])
  @@index([type])
  @@index([position])
  @@map("stays")
}

/// A label and value on a stay's page, e.g. ("Transfer", "Speedboat, 45 min").
model StayFact {
  id       Int    @id @default(autoincrement())
  stayId   String @map("stay_id")
  position Int
  label    String
  value    String
  stay     Stay   @relation(fields: [stayId], references: [id], onDelete: Cascade)

  @@index([stayId])
  @@map("stay_facts")
}

/// A photo in a stay's gallery.
model StayPhoto {
  id       Int     @id @default(autoincrement())
  stayId   String  @map("stay_id")
  position Int
  src      String
  alt      String
  caption  String?
  stay     Stay    @relation(fields: [stayId], references: [id], onDelete: Cascade)

  @@index([stayId])
  @@map("stay_photos")
}

/// A guest review of a stay.
model StayReview {
  id       Int    @id @default(autoincrement())
  stayId   String @map("stay_id")
  position Int
  author   String
  from     String @default("")
  date     String @default("")
  rating   Float
  text     String
  stay     Stay   @relation(fields: [stayId], references: [id], onDelete: Cascade)

  @@index([stayId])
  @@map("stay_reviews")
}

// ---- content tables (generated by scripts/gen-content-models.ts) ----

/// A guide (things to do), published at /guides/<slug>.
model Guide {
  id        String         @id @default(cuid())
  /// order on the site and in the dashboard
  sortOrder Int            @map("sort_order")
  slug      String         @unique
  title     String
  short     String
  summary   String
  category  String
  atoll     String
  season    String
  read      Int
  image     String
  /// dashboard user who created it
  author    String?
  updatedBy String?        @map("updated_by")
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")
  sections  GuideSection[]
  facts     GuideFact[]
  photos    GuidePhoto[]

  @@index([sortOrder])
  @@index([category])
  @@map("guides")
}

/// A heading and its text, shown as a numbered section.
model GuideSection {
  id        Int    @id @default(autoincrement())
  ownerId   String @map("owner_id")
  sortOrder Int    @map("sort_order")
  heading   String
  text      String
  owner     Guide  @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@map("guide_sections")
}

/// A label and value shown at a glance.
model GuideFact {
  id        Int    @id @default(autoincrement())
  ownerId   String @map("owner_id")
  sortOrder Int    @map("sort_order")
  label     String
  value     String
  owner     Guide  @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@map("guide_facts")
}

/// A photo in the gallery.
model GuidePhoto {
  id        Int     @id @default(autoincrement())
  ownerId   String  @map("owner_id")
  sortOrder Int     @map("sort_order")
  src       String
  alt       String
  caption   String?
  owner     Guide   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@map("guide_photos")
}

/// An atoll (or a single-island profile with `parent` set), published at /atolls/<slug>.
model Atoll {
  id                   String            @id @default(cuid())
  /// order on the site and in the dashboard
  sortOrder            Int               @map("sort_order")
  slug                 String            @unique
  name                 String
  dhivehi              String
  region               String
  tagline              String
  intro                String
  bestFor              String[]          @default([]) @map("best_for")
  transfer             String
  image                String
  parent               String?
  islandsInhabited     String[]          @default([]) @map("islands_inhabited")
  islandsUninhabited   String[]          @default([]) @map("islands_uninhabited")
  islandsResortIslands String[]          @default([]) @map("islands_resort_islands")
  hasIslands           Boolean           @default(false) @map("has_islands")
  /// dashboard user who created it
  author               String?
  updatedBy            String?           @map("updated_by")
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")
  photos               AtollPhoto[]
  sections             AtollSection[]
  facts                AtollFact[]
  resorts              AtollResort[]
  halfResorts          AtollHalfResort[]

  @@index([sortOrder])
  @@index([parent])
  @@map("atolls")
}

/// A photo in the gallery.
model AtollPhoto {
  id        Int     @id @default(autoincrement())
  ownerId   String  @map("owner_id")
  sortOrder Int     @map("sort_order")
  src       String
  alt       String
  caption   String?
  owner     Atoll   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@map("atoll_photos")
}

/// A heading and its text, shown as a numbered section.
model AtollSection {
  id        Int    @id @default(autoincrement())
  ownerId   String @map("owner_id")
  sortOrder Int    @map("sort_order")
  heading   String
  text      String
  owner     Atoll  @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@map("atoll_sections")
}

/// A label and value shown at a glance.
model AtollFact {
  id        Int    @id @default(autoincrement())
  ownerId   String @map("owner_id")
  sortOrder Int    @map("sort_order")
  label     String
  value     String
  owner     Atoll  @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@map("atoll_facts")
}

/// A resort island: one island, one resort.
model AtollResort {
  id        Int    @id @default(autoincrement())
  ownerId   String @map("owner_id")
  sortOrder Int    @map("sort_order")
  island    String
  resort    String
  owner     Atoll  @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@map("atoll_resorts")
}

/// An island that is part local community, part resort or hotel.
model AtollHalfResort {
  id        Int    @id @default(autoincrement())
  ownerId   String @map("owner_id")
  sortOrder Int    @map("sort_order")
  island    String
  resort    String
  owner     Atoll  @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@map("atoll_half_resorts")
}

/// An island page, /atolls/<atoll>/islands/<slug>, and its card on the atoll page.
model Island {
  id             String          @id @default(cuid())
  /// order on the site and in the dashboard
  sortOrder      Int             @map("sort_order")
  slug           String
  name           String
  atoll          String
  atollSlug      String?         @map("atoll_slug")
  kind           String
  tagline        String?
  description    String
  population     Int?
  populationYear String?         @map("population_year")
  area           Float?
  image          String?
  imageCredit    String?         @map("image_credit")
  imageSource    String?         @map("image_source")
  source         String?
  lat            Float?
  lng            Float?
  highlights     String[]        @default([])
  gettingThere   String?         @map("getting_there")
  /// dashboard user who created it
  author         String?
  updatedBy      String?         @map("updated_by")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  photos         IslandPhoto[]
  sections       IslandSection[]

  @@index([sortOrder])
  @@index([slug])
  @@index([atollSlug])
  @@map("islands")
}

/// A photo in the gallery.
model IslandPhoto {
  id        Int     @id @default(autoincrement())
  ownerId   String  @map("owner_id")
  sortOrder Int     @map("sort_order")
  src       String
  alt       String
  caption   String?
  owner     Island  @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@map("island_photos")
}

/// A heading and its text, shown as a numbered section.
model IslandSection {
  id        Int    @id @default(autoincrement())
  ownerId   String @map("owner_id")
  sortOrder Int    @map("sort_order")
  heading   String
  text      String
  owner     Island @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@map("island_sections")
}

/// A place to eat, published at /eat-drink/<slug>.
model Eat {
  id         String         @id @default(cuid())
  /// order on the site and in the dashboard
  sortOrder  Int            @map("sort_order")
  slug       String?
  name       String
  kind       String
  atoll      String?
  atollSlug  String?        @map("atoll_slug")
  island     String?
  area       String
  price      String
  dish       String
  image      String
  about      String?
  hours      String?
  rating     Float?
  address    String?
  lat        Float?
  lng        Float?
  /// dashboard user who created it
  author     String?
  updatedBy  String?        @map("updated_by")
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")
  recommends EatRecommend[]
  reviews    EatReview[]

  @@index([sortOrder])
  @@index([slug])
  @@index([atollSlug])
  @@map("eats")
}

/// A dish worth ordering here, with a short reason.
model EatRecommend {
  id        Int    @id @default(autoincrement())
  ownerId   String @map("owner_id")
  sortOrder Int    @map("sort_order")
  dish      String
  note      String
  owner     Eat    @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@map("eat_recommends")
}

/// A guest review.
model EatReview {
  id        Int    @id @default(autoincrement())
  ownerId   String @map("owner_id")
  sortOrder Int    @map("sort_order")
  author    String
  from      String
  date      String
  rating    Float
  text      String
  owner     Eat    @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@map("eat_reviews")
}

/// A dish to know, in "What to eat".
model Dish {
  id         String   @id @default(cuid())
  /// order on the site and in the dashboard
  sortOrder  Int      @map("sort_order")
  name       String
  local      String?
  kind       String
  text       String
  whereToTry String?  @map("where_to_try")
  image      String
  vegetarian Boolean?
  /// dashboard user who created it
  author     String?
  updatedBy  String?  @map("updated_by")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([sortOrder])
  @@map("dishes")
}

/// A date in the year (What's on).
model Event {
  id        String   @id @default(cuid())
  /// order on the site and in the dashboard
  sortOrder Int      @map("sort_order")
  month     String
  title     String
  text      String
  place     String
  /// dashboard user who created it
  author    String?
  updatedBy String?  @map("updated_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([sortOrder])
  @@map("events")
}

/// A practical fact for planning a trip.
model Essential {
  id        String   @id @default(cuid())
  /// order on the site and in the dashboard
  sortOrder Int      @map("sort_order")
  label     String
  big       String
  text      String
  href      String?
  /// dashboard user who created it
  author    String?
  updatedBy String?  @map("updated_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([sortOrder])
  @@map("essentials")
}

/// A salon, spa or barber, published at /salons/<slug>.
model Salon {
  id        String        @id @default(cuid())
  /// order on the site and in the dashboard
  sortOrder Int           @map("sort_order")
  slug      String?
  name      String
  kind      String
  services  String[]      @default([])
  atoll     String?
  atollSlug String?       @map("atoll_slug")
  island    String?
  area      String
  address   String?
  lat       Float?
  lng       Float?
  rating    Float?
  image     String
  about     String?
  hours     String?
  phone     String?
  link      String?
  /// dashboard user who created it
  author    String?
  updatedBy String?       @map("updated_by")
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")
  reviews   SalonReview[]

  @@index([sortOrder])
  @@index([slug])
  @@index([atollSlug])
  @@map("salons")
}

/// A guest review.
model SalonReview {
  id        Int    @id @default(autoincrement())
  ownerId   String @map("owner_id")
  sortOrder Int    @map("sort_order")
  author    String
  from      String
  date      String
  rating    Float
  text      String
  owner     Salon  @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@map("salon_reviews")
}

/// A section built in the dashboard (Page sections).
model PageSection {
  id           String            @id @default(cuid())
  /// order on the site and in the dashboard
  sortOrder    Int               @map("sort_order")
  title        String
  published    Boolean
  displayOrder Int?              @map("display_order")
  placement    String
  scope        String
  atoll        String?
  atollSlug    String?           @map("atoll_slug")
  island       String?
  pageSlug     String?           @map("page_slug")
  pageTitle    String?           @map("page_title")
  slot         String
  eyebrow      String?
  intro        String?
  block        String
  source       String?
  area         String?
  kindFilter   String?           @map("kind_filter")
  maxItems     Int?              @map("max_items")
  body         String?
  image        String?
  imageSide    String?           @map("image_side")
  buttonLabel  String?           @map("button_label")
  buttonLink   String?           @map("button_link")
  /// dashboard user who created it
  author       String?
  updatedBy    String?           @map("updated_by")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")
  items        PageSectionItem[]

  @@index([sortOrder])
  @@index([atollSlug])
  @@index([pageSlug])
  @@map("page_sections")
}

/// A hand-picked card, photo or link in a section.
model PageSectionItem {
  id        Int         @id @default(autoincrement())
  ownerId   String      @map("owner_id")
  sortOrder Int         @map("sort_order")
  title     String
  text      String?
  image     String?
  link      String?
  owner     PageSection @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@map("page_section_items")
}

// ---- end of content tables ----
