# Copy to .env.local for local development. On Vercel, set these under
# Project → Settings → Environment Variables (never commit real values).

# --- Database (Neon Postgres) ---------------------------------------------------
# Vercel → Storage → Create database → Neon adds both automatically.
# Pooled URL, used by the site:
DATABASE_URL=
# Direct (unpooled) URL, used by Prisma migrations:
DATABASE_URL_UNPOOLED=

# --- Dashboard sign-in ----------------------------------------------------------
# Signs session cookies. A random value of 32+ characters: `openssl rand -base64 32`
SESSION_SECRET=

# First admin only: sign in with these once to create the admin account, then
# remove ADMIN_PASSWORD. Everyone else is added from Dashboard → Users.
ADMIN_EMAIL=
ADMIN_PASSWORD=
